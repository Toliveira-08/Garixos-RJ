# Copie este arquivo para .env e preencha os valores.
# NUNCA faça commit do arquivo .env.

PORT=3000

# --- Banco de dados (PostgreSQL) ---
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=garixos_dev
# Em produção, você pode usar uma única URL no lugar das variáveis acima:
# DATABASE_URL=postgres://usuario:senha@host:5432/garixos
# DB_SSL=true

# --- Autenticação ---
# Gere um valor aleatório, ex.: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=troque-por-um-valor-aleatorio-e-longo
JWT_EXPIRES_IN=8h

# --- Usuário administrador criado pelo seed (npm run db:seed) ---
ADMIN_EMAIL=admin@garixos.com
ADMIN_PASSWORD=troque-esta-senha

# --- Assistente virtual (opcional) ---
# Sem chave, a assistente responde com um conjunto de respostas prontas.
GEMINI_API_KEY=
